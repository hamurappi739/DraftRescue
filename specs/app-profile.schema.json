{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draftrescue.local/schemas/app-profile.v1.json",
  "title": "DraftRescue App Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "profileVersion",
    "displayName",
    "supportLevel",
    "applicationMatch",
    "capturePolicy",
    "completionPolicy",
    "recoveryPolicy",
    "restorePolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "supportLevel": {
      "enum": [
        "unsupported",
        "experimental",
        "supported"
      ]
    },
    "applicationMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executableNames"
      ],
      "properties": {
        "executableNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "browserFamily": {
          "enum": [
            "none",
            "chromium",
            "firefox"
          ]
        }
      }
    },
    "frameworkHints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "win32",
          "wpf",
          "winui",
          "chromium",
          "electron",
          "unknown"
        ]
      }
    },
    "capturePolicy": {
      "enum": [
        "disabled",
        "genericUiaValue",
        "genericUiaText",
        "appSpecificAdapter"
      ]
    },
    "browserPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateModeHandling",
        "privateModeDetectorId"
      ],
      "properties": {
        "privateModeHandling": {
          "const": "deny"
        },
        "privateModeDetectorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "allowOriginFingerprinting": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "completionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusLossIsCompletion"
      ],
      "properties": {
        "focusLossIsCompletion": {
          "const": false
        },
        "detectorId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "recoveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredStrongAnchors"
      ],
      "properties": {
        "requiredStrongAnchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "application",
              "fieldIdentity",
              "windowContext",
              "browserOrigin",
              "appSpecific"
            ]
          }
        },
        "optionalAnchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "windowContext",
              "browserOrigin",
              "geometry",
              "appSpecific"
            ]
          }
        },
        "fatalConflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "application",
              "securityState",
              "browserOrigin",
              "fieldIdentity"
            ]
          }
        }
      }
    },
    "restorePolicy": {
      "enum": [
        "copyOnly",
        "valuePattern",
        "legacyAccessibleValue",
        "appSpecificAdapter"
      ]
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "targetCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionScheme",
        "certifiedRanges"
      ],
      "properties": {
        "versionScheme": {
          "enum": [
            "windowsFileVersion",
            "semver",
            "chromiumMajor",
            "opaqueExact"
          ]
        },
        "certifiedRanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minInclusive": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "maxInclusive": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "exact": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              }
            },
            "anyOf": [
              {
                "required": [
                  "exact"
                ]
              },
              {
                "required": [
                  "minInclusive"
                ]
              },
              {
                "required": [
                  "maxInclusive"
                ]
              }
            ]
          }
        },
        "blockedRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minInclusive": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "maxInclusive": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "exact": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              }
            },
            "anyOf": [
              {
                "required": [
                  "exact"
                ]
              },
              {
                "required": [
                  "minInclusive"
                ]
              },
              {
                "required": [
                  "maxInclusive"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supportLevel": {
            "const": "supported"
          }
        }
      },
      "then": {
        "required": [
          "targetCompatibility"
        ]
      }
    }
  ]
}
