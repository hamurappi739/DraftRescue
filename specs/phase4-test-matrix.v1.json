  "faultScenarios": [
    {
      "id": "P4F-001",
      "scenario": "DPAPI Protect throws",
      "expected": "no repository call; plaintext not logged"
    },
    {
      "id": "P4F-002",
      "scenario": "DPAPI Unprotect throws",
      "expected": "typed unreadable record; no fallback"
    },
    {
      "id": "P4F-003",
      "scenario": "secret missing with existing DB",
      "expected": "identity unavailable; no silent new key"
    },
    {
      "id": "P4F-004",
      "scenario": "secret corrupt",
      "expected": "fail closed; no guessing"
    },
    {
      "id": "P4F-005",
      "scenario": "SQLite open fails",
      "expected": "storage unavailable; bounded behavior"
    },
    {
      "id": "P4F-006",
      "scenario": "DB busy timeout",
      "expected": "typed bounded failure"
    },
    {
      "id": "P4F-007",
      "scenario": "crash before commit",
      "expected": "old complete state remains"
    },
    {
      "id": "P4F-008",
      "scenario": "crash after commit",
      "expected": "new complete state available"
    },
    {
      "id": "P4F-009",
      "scenario": "late stale encrypted sequence",
      "expected": "StaleIgnored"
    },
    {
      "id": "P4F-010",
      "scenario": "equal sequence contradictory record",
      "expected": "typed conflict"
    },
    {
      "id": "P4F-011",
      "scenario": "corrupt DB",
      "expected": "quarantine/fail closed; no salvage"
    },
    {
      "id": "P4F-012",
      "scenario": "unknown user_version",
      "expected": "incompatible; no auto-drop"
    },
    {
      "id": "P4F-013",
      "scenario": "migration failure",
      "expected": "transaction rollback / safe failure"
    },
    {
      "id": "P4F-014",
      "scenario": "disk full",
      "expected": "old commit remains; no plaintext fallback"
    },
    {
      "id": "P4F-015",
      "scenario": "expiry deletion fails",
      "expected": "expired stays hidden"
    },
    {
      "id": "P4F-016",
      "scenario": "500 updates",
      "expected": "one logical row per DraftId"
    },
    {
      "id": "P4F-017",
      "scenario": "canary scan",
      "expected": "zero durable plaintext canary"
    },
    {
      "id": "P4F-018",
      "scenario": "metadata list 100 rows",
      "expected": "Unprotect count zero"
    },
    {
      "id": "P4F-019",
      "scenario": "discard all",
      "expected": "decrypt count zero"
    },
    {
      "id": "P4F-020",
      "scenario": "kill during rollback-journal commit",
      "expected": "valid recovered SQLite transaction state"
    }
  ]
}
